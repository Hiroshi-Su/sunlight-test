{
  "name": "soracity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:py": ".venv/bin/python -m unittest discover -s tests -v",
    "fixtures": ".venv/bin/python tests/gen_fixtures.py",
    "app": "vite build && electron .",
    "app:forever": "vite build && node scripts/supervise.mjs",
    "logs": "node scripts/log-summary.mjs",
    "app:kiosk": "vite build && electron . --mode=kiosk"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "vite": "^6.4.3"
  },
  "main": "electron/main.js"
}
