{
  "name": "soracity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-electron.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:py": ".venv/bin/python -m unittest discover -s tests -v",
    "fixtures": ".venv/bin/python tests/gen_fixtures.py",
    "check": "npm run typecheck && npm test && npm run test:py",
    "app": "npm run build && electron .",
    "app:kiosk": "npm run build && electron . --mode=kiosk",
    "app:forever": "npm run build && node scripts/supervise.ts",
    "logs": "node scripts/log-summary.ts"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.170.0",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  },
  "main": "dist-electron/main.js"
}
